{
  "name": "dbms-learning-portal",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev --workspace=server\" \"npm:dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "seed:course": "npm run seed:course --workspace=server",
    "seed:admin": "npm run seed:admin --workspace=server",
    "seed": "npm run seed --workspace=server",
    "validate:course": "node scripts/validate-course.js",
    "test": "npm run test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
