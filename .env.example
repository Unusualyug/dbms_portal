# Copy to .env in the repository root. Never commit .env or real credentials.
NODE_ENV=development
PORT=5000
# Public frontend URL; password reset links use the first URL if multiple are comma-separated.
CLIENT_URL=http://localhost:5173,http://192.168.56.1:5173

# Local MongoDB Community Server default. Replace with your MongoDB Atlas URI if using Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/dbms_learning_portal

# Required for authentication; generate a random 32-byte (or longer) secret.
JWT_SECRET=
JWT_EXPIRES_IN=4h
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Exactly one admin identity is allowed; the seed script enforces this address.
ADMIN_EMAIL=yglakhani@gmiu.edu.in
# Set a private password of at least 12 characters before running the admin seed.
ADMIN_PASSWORD=

# Optional Judge0 integration for non-Oracle/general-language exercises only.
# Never use Judge0's SQLite SQL dialect to claim Oracle SQL/PLSQL correctness.
JUDGE0_API_URL=
JUDGE0_API_KEY=
JUDGE0_SQLITE_LANGUAGE_ID=82

# Optional SMTP transport for admin report emails and student password-reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
REPORT_FROM_EMAIL=

# Optional Cloudinary storage for student profile photos (server-side only).
# Set all three values from the Cloudinary dashboard; never expose the API secret to the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Presence threshold (seconds); online means a recent authenticated heartbeat.
ONLINE_THRESHOLD_SECONDS=90
